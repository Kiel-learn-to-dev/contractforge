import { CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { DateInput } from "../components/date_input.slint";
import { SearchableCombo } from "../components/searchable_combo.slint";
import { Card, CfButton } from "../components/common.slint";
import { ContractHub } from "../globals.slint";

// Một gói bổ sung có thể chọn trên form.
export struct FormAddonRow {
    id: int,
    name: string,
    checked: bool,
}

// S14 — form sinh hợp đồng (2 cột giống Python contracts/form.html).
export component ContractFormScreen inherits ScrollView {
    in property <[string]> customer-names;
    in property <int> customer-index: -1;
    in property <[string]> main-names;
    in property <int> main-index: -1;
    in property <[string]> template-names;
    in property <int> template-index: -1;
    in property <[FormAddonRow]> addon-rows;
    in property <string> number-text;
    in property <string> end-date-text;
    in property <string> form-summary-text;
    in property <string> form-error-text;

    callback customer-changed(int);
    callback product-changed(int);
    callback template-changed(int);
    callback addon-toggled(int);
    callback field-changed(string, string);
    callback save(bool);

    // Derive all form columns from the actual ScrollView viewport. The outer
    // padding is removed exactly once so card widths never depend on preferred
    // child widths.
    property <length> form-content-width: max(0px, root.visible-width - 2 * Theme.pad);
    property <bool> side-by-side: root.form-content-width >= 860px;
    property <length> party-column-width: min(400px, max(260px, root.form-content-width * 0.30));
    property <length> contract-column-width: root.side-by-side
        ? max(575px, root.form-content-width - root.party-column-width - 14px)
        : root.form-content-width;
    property <length> party-column-layout-width: root.side-by-side
        ? root.party-column-width : root.form-content-width;

    VerticalLayout {
        width: root.visible-width;
        padding: Theme.pad;
        spacing: Theme.gap;

        if ContractHub.party-b-incomplete : Card {
            border-color: Theme.warning-fg;
            background: Theme.warning-bg;
            HorizontalLayout {
                padding: 10px;
                spacing: Theme.gap;
                Text { horizontal-stretch: 1; text: "Hồ sơ Bên B chưa đầy đủ. Hãy cấu hình trước khi sinh hợp đồng."; color: Theme.warning-fg; vertical-alignment: center; }
                CfButton { text: "Mở Cài đặt"; variant: "outline-primary"; clicked => { ContractHub.open-settings(); } }
            }
        }

        if root.form-error-text != "" : Card {
            border-color: Theme.danger-fg;
            background: Theme.danger-bg;
            HorizontalLayout {
                padding: 10px;
                Text { text: root.form-error-text; color: Theme.danger-fg; wrap: word-wrap; }
            }
        }

        if ContractHub.date-warnings != "" : Card {
            border-color: Theme.warning-fg;
            background: Theme.warning-bg;
            HorizontalLayout {
                padding: 10px;
                Text { text: ContractHub.date-warnings; color: Theme.warning-fg; wrap: word-wrap; }
            }
        }

        // Hai cột khi đủ chỗ, xếp dọc ở cửa sổ hẹp.
        FlexboxLayout {
            width: root.form-content-width;
            flex-direction: root.side-by-side ? row : column;
            flex-wrap: no-wrap;
            alignment: stretch;
            spacing: 14px;
            cross-axis-alignment: start;

            // Cột trái
            VerticalLayout {
                width: root.contract-column-width;
                alignment: start;
                spacing: Theme.gap;

                // 1. Thông tin hợp đồng & Khách hàng
                Card {
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 10px;
                        Text { text: "THÔNG TIN HỢP ĐỒNG"; font-weight: 700; color: Theme.primary; font-size: Theme.font-small; }
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            spacing: Theme.gap;
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "SỐ HỢP ĐỒNG *"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                LineEdit {
                                    min-width: 0px;
                                    height: Theme.control-height;
                                    text: root.number-text;
                                    placeholder-text: "Tự động gợi ý khi chọn khách hàng";
                                    edited(t) => { root.field-changed("number", t); }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "ĐỊA ĐIỂM KÝ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                LineEdit {
                                    min-width: 0px;
                                    height: Theme.control-height;
                                    text <=> ContractHub.location;
                                    placeholder-text: "Tự điền theo tên đơn vị";
                                    edited(t) => { root.field-changed("location", t); }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "KHÁCH HÀNG (BÊN A) *"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                            LineEdit {
                                min-width: 0px;
                                height: 30px;
                                placeholder-text: "Lọc nhanh theo tên hoặc mã không dấu...";
                                text <=> ContractHub.customer-filter;
                                edited(t) => { ContractHub.filter-customers(t); }
                            }
                            SearchableCombo {
                                height: Theme.control-height;
                                model: root.customer-names;
                                current-index: root.customer-index;
                                selected(v) => { root.customer-changed(self.current-index); }
                            }
                            if ContractHub.customer-info-text != "" : Text {
                                text: ContractHub.customer-info-text;
                                color: Theme.text-muted;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap;
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "SẢN PHẨM / DỊCH VỤ *"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                SearchableCombo {
                                    height: Theme.control-height;
                                    model: root.main-names;
                                    current-index: root.main-index;
                                    selected(v) => { root.product-changed(self.current-index); }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "MẪU HỢP ĐỒNG *"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                SearchableCombo {
                                    height: Theme.control-height;
                                    enabled: root.main-index >= 0;
                                    model: root.main-index >= 0 ? root.template-names : ["— Chọn sản phẩm trước —"];
                                    current-index: root.main-index >= 0 ? root.template-index : 0;
                                    selected(v) => { root.template-changed(self.current-index); }
                                }
                            }
                        }
                    }
                }

                // 2. Thời hạn
                Card {
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 10px;
                        Text { text: "THỜI HẠN"; font-weight: 700; color: Theme.primary; font-size: Theme.font-small; }
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            spacing: Theme.gap;
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "NGÀY KÝ (dd/mm/yyyy)"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                DateInput { height: Theme.control-height; text <=> ContractHub.sign-date; placeholder-text: "dd/mm/yyyy"; edited(t) => { root.field-changed("sign_date", t); } }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "NGÀY BẮT ĐẦU"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                DateInput { height: Theme.control-height; text <=> ContractHub.start-date; placeholder-text: "dd/mm/yyyy"; edited(t) => { root.field-changed("start_date", t); } }
                            }
                            VerticalLayout {
                                width: 95px; spacing: 4px;
                                Text { text: "SỐ THÁNG"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                LineEdit { min-width: 0px; height: Theme.control-height; text <=> ContractHub.months; placeholder-text: "12"; edited(t) => { root.field-changed("months", t); } }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "NGÀY KẾT THÚC"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                DateInput { height: Theme.control-height; text <=> ContractHub.end-date-input; placeholder-text: "Tự tính hoặc sửa"; edited(t) => { root.field-changed("end_date", t); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap;
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "NGÀY NGHIỆM THU"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                DateInput { height: Theme.control-height; text <=> ContractHub.acceptance-date; placeholder-text: "dd/mm/yyyy"; edited(t) => { root.field-changed("acceptance_date", t); } }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 4px;
                                Text { text: "NGÀY THANH LÝ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                DateInput { height: Theme.control-height; text <=> ContractHub.liquidation-date; placeholder-text: "dd/mm/yyyy"; edited(t) => { root.field-changed("liquidation_date", t); } }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                // 3. Giá trị hợp đồng & Cơ sở áp dụng
                Card {
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 10px;
                        Text { text: "GIÁ TRỊ HỢP ĐỒNG & CƠ SỞ ÁP DỤNG"; font-weight: 700; color: Theme.success-fg; font-size: Theme.font-small; }
                        Rectangle { height: 1px; background: Theme.border; }

                        HorizontalLayout {
                            spacing: Theme.gap;
                            VerticalLayout {
                                width: 120px; spacing: 4px;
                                Text { text: "SỐ CƠ SỞ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                LineEdit { min-width: 0px; height: Theme.control-height; text <=> ContractHub.unit-count-input; edited(t) => { root.field-changed("unit_count", t); } }
                            }
                            VerticalLayout {
                                width: 185px; spacing: 4px;
                                Text { text: "HÌNH THỨC THANH TOÁN"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                SearchableCombo {
                                    height: Theme.control-height;
                                    model: ["— Chưa chọn —", "Trả trước", "Trả sau"];
                                    current-index: ContractHub.payment-mode-index;
                                    selected(v) => { ContractHub.payment-mode-changed(self.current-index); }
                                }
                            }
                            VerticalLayout {
                                width: 165px; spacing: 4px;
                                Text { text: "CHU KỲ TT (THÁNG)"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                                LineEdit { min-width: 0px; height: Theme.control-height; text <=> ContractHub.payment-cycle-months; placeholder-text: "VD: 12"; edited(t) => { root.field-changed("payment_cycle_months", t); } }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if ContractHub.facilities.length > 0 : VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: Theme.gap;
                                Text { text: "Cơ sở áp dụng (" + ContractHub.unit-count-text + ")"; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                CfButton { text: "Chọn hết"; clicked => { ContractHub.select-all-facilities(true); } }
                                CfButton { text: "Bỏ hết"; clicked => { ContractHub.select-all-facilities(false); } }
                            }
                            for fac[idx] in ContractHub.facilities : CheckBox {
                                text: fac.label;
                                checked: fac.checked;
                                toggled => { ContractHub.toggle-facility(idx); }
                            }
                        }

                        // Bảng dòng giá trị (máy chủ tính)
                        if ContractHub.price-lines.length > 0 : VerticalLayout {
                            spacing: 4px;
                            Rectangle {
                                height: 28px;
                                background: Theme.surface-2;
                                border-radius: Theme.radius-sm;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 6px;
                                    Text { horizontal-stretch: 1; text: "DỊCH VỤ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                                    Text { width: 55px; text: "ĐVT"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                                    Text { width: 45px; text: "SL"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 90px; text: "ĐƠN GIÁ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 45px; text: "VAT"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 105px; text: "SAU THUẾ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                            for line in ContractHub.price-lines : Rectangle {
                                height: 30px;
                                border-color: Theme.border;
                                border-width: 1px;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 6px;
                                    Text { horizontal-stretch: 1; text: line.name; font-size: Theme.font-small; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                    Text { width: 55px; text: line.unit; font-size: Theme.font-small; color: Theme.text-muted; vertical-alignment: center; }
                                    Text { width: 45px; text: line.qty; font-size: Theme.font-small; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 90px; text: line.price; font-size: Theme.font-small; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 45px; text: line.vat-rate; font-size: Theme.font-small; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { width: 105px; text: line.total; font-size: Theme.font-small; font-weight: 700; color: Theme.primary; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: end;
                                Text { text: "Trước thuế: " + ContractHub.price-pre-vat; font-size: Theme.font-small; color: Theme.text-2; }
                                Text { text: "Thuế: " + ContractHub.price-vat; font-size: Theme.font-small; color: Theme.text-2; }
                                Text { text: "Tổng sau thuế: " + ContractHub.price-total; font-size: Theme.font-body; font-weight: 700; color: Theme.success-fg; }
                            }
                        }

                        if root.addon-rows.length > 0 : VerticalLayout {
                            spacing: 4px;
                            Text { text: "Gói bổ sung cùng nhóm (tích để thêm dòng):"; font-size: Theme.font-small; color: Theme.text-muted; }
                            for addon[index] in root.addon-rows : CheckBox {
                                text: addon.name;
                                checked: addon.checked;
                                toggled => { root.addon-toggled(index); }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "SỐ TIỀN BẰNG CHỮ (tự sinh — có thể sửa)"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { min-width: 0px; height: Theme.control-height; text <=> ContractHub.amount-words; edited(t) => { root.field-changed("amount_text", t); } }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "MÔ TẢ CÁCH TÍNH GIÁ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { min-width: 0px; height: Theme.control-height; text <=> ContractHub.pricing-desc; edited(t) => { root.field-changed("pricing_description", t); } }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap;
                            Text { width: 150px; text: "Tổng tiền ghi đè (tùy chọn)"; vertical-alignment: center; color: Theme.text-muted; font-size: Theme.font-small; }
                            LineEdit { width: 200px; height: Theme.control-height; text <=> ContractHub.total-text; placeholder-text: "VD: 1.250.000"; edited(t) => { root.field-changed("total", t); } }
                        }
                    }
                }
            }

            // Cột phải
            VerticalLayout {
                width: root.party-column-layout-width;
                spacing: Theme.gap;
                alignment: start;

                // Bên B
                Card {
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 8px;
                        Text { text: "BÊN B (VIETTEL)"; font-weight: 700; color: Theme.text; font-size: Theme.font-small; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Text { text: "Đại diện Bên B"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                        LineEdit { min-width: 0px; height: Theme.control-height; text <=> ContractHub.party-b-rep; edited(t) => { root.field-changed("party_b_rep", t); } }
                        Text { text: "Số giấy uỷ quyền"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                        LineEdit { min-width: 0px; height: Theme.control-height; text <=> ContractHub.party-b-auth-num; edited(t) => { root.field-changed("party_b_auth_num", t); } }
                        Text { text: "Ngày uỷ quyền"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                        DateInput { height: Theme.control-height; text <=> ContractHub.party-b-auth-date; edited(t) => { root.field-changed("party_b_auth_date", t); } }
                    }
                }

                // Ghi chú nội bộ
                Card {
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 8px;
                        Text { text: "GHI CHÚ NỘI BỘ"; font-weight: 700; color: Theme.text; font-size: Theme.font-small; }
                        LineEdit { min-width: 0px; height: 36px; text <=> ContractHub.notes; placeholder-text: "Ghi chú thêm cho hợp đồng..."; edited(t) => { root.field-changed("notes", t); } }
                    }
                }

                // Sinh kèm văn bản
                if ContractHub.form-attachments.length > 0 : Card {
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 6px;
                        Text { text: "SINH KÈM VĂN BẢN (" + ContractHub.selected-att-count + ")"; font-weight: 700; color: Theme.info-fg; font-size: Theme.font-small; }
                        Rectangle { height: 1px; background: Theme.border; }
                        for att[idx] in ContractHub.form-attachments : CheckBox {
                            text: att.label;
                            checked: att.checked;
                            toggled => { ContractHub.toggle-form-attachment(idx); }
                        }
                        Text {
                            text: "Có tick thì sinh cùng lúc và đóng gói ZIP kèm hợp đồng.";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            wrap: word-wrap;
                        }
                    }
                }

                // Nút thao tác
                Card {
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 8px;
                        CfButton { text: "Tạo hợp đồng và sinh .docx"; variant: "primary"; clicked => { root.save(true); } }
                        CfButton { text: "Chỉ lưu nháp"; variant: "outline-primary"; clicked => { root.save(false); } }
                        CfButton { text: "Hủy"; clicked => { ContractHub.cancel-form(); } }
                        Rectangle {
                            background: Theme.warning-bg;
                            border-radius: Theme.radius-sm;
                            HorizontalLayout {
                                padding: 8px;
                                Text {
                                    text: "Nếu mẫu hợp đồng hợp lệ, hệ thống sẽ sinh file .docx ngay sau khi tạo.";
                                    color: Theme.warning-fg;
                                    font-size: Theme.font-xs;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
