import { CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SearchableCombo } from "../components/searchable_combo.slint";
import { Card, CfButton, StatusBadge, EmptyState } from "../components/common.slint";
import { CustomerRowData } from "../types.slint";
import { CustomerHub } from "../globals.slint";

// S03 — danh sách khách hàng.
export component CustomersScreen inherits VerticalLayout {
    in property <[CustomerRowData]> rows;
    in property <[string]> ward-options;
    in property <[string]> type-options;
    in property <int> ward-index: 0;
    in property <int> type-index: 0;
    in property <bool> active-only: true;
    in property <string> summary-text;
    in property <string> page-text;
    in property <bool> has-prev: false;
    in property <bool> has-next: false;
    in property <int> selected-count: 0;

    callback search-changed(string);
    callback filter-changed(int, int, bool);
    callback toggle-row(int);
    callback open-detail(int);
    callback add-customer();
    callback open-import();
    callback export-report();
    callback open-trash();
    callback prev-page();
    callback next-page();
    callback delete-selected();

    spacing: Theme.gap;

    // Thanh công cụ trên cùng
    FlexboxLayout {
        vertical-stretch: 0;
        alignment: stretch;
        cross-axis-alignment: center;
        spacing: Theme.gap;
        Text { text: root.summary-text; color: Theme.text-muted; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        CfButton { text: "Thùng rác"; clicked => { root.open-trash(); } }
        CfButton { text: "Xuất báo cáo"; variant: "outline-primary"; clicked => { root.export-report(); } }
        CfButton { text: "Nhập Excel"; variant: "outline-primary"; clicked => { root.open-import(); } }
        CfButton { text: "+ Thêm khách hàng"; variant: "primary"; clicked => { root.add-customer(); } }
    }

    // Thanh tìm kiếm & bộ lọc
    FlexboxLayout {
        vertical-stretch: 0;
        alignment: stretch;
        cross-axis-alignment: center;
        spacing: Theme.gap;
        LineEdit {
            min-width: 200px;
            preferred-width: 250px;
            horizontal-stretch: 1;
            height: Theme.control-height;
            text <=> CustomerHub.list-search-text;
            placeholder-text: "Tìm tên, tên ngắn, mã, MST hoặc đại diện (có/không dấu)";
            edited(text) => { root.search-changed(text); }
        }
        SearchableCombo {
            width: 190px;
            height: 32px;
            model: root.ward-options;
            current-index: root.ward-index;
            selected(value) => { root.filter-changed(self.current-index, root.type-index, root.active-only); }
        }
        SearchableCombo {
            width: 170px;
            height: 32px;
            model: root.type-options;
            current-index: root.type-index;
            selected(value) => { root.filter-changed(root.ward-index, self.current-index, root.active-only); }
        }
        CheckBox {
            text: "Chỉ đang hoạt động";
            checked: root.active-only;
            toggled => { root.filter-changed(root.ward-index, root.type-index, self.checked); }
        }
        CfButton { text: "Xóa lọc"; clicked => { CustomerHub.list-reset-filters(); } }
    }

    if root.rows.length == 0 : EmptyState {
        vertical-stretch: 1;
        message: "Không có khách hàng nào khớp bộ lọc.";
    }
    // Tiêu đề và dữ liệu dùng chung vùng cuộn để luôn thẳng cột.
    if root.rows.length > 0 : Card {
        vertical-stretch: 1;
        min-width: 0px;
        clip: true;
        min-height: 0px;
        preferred-height: table-content.preferred-height + 14px;
        max-height: self.preferred-height;
        table := ScrollView {
            min-width: 0px;
            content-width: max(self.visible-width, 875px);
            table-content := VerticalLayout {
                width: table.content-width;
                spacing: 0px;
                Rectangle {
                    height: 34px;
                    background: Theme.surface-2;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: Theme.radius-sm;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 8px;
                        CheckBox {
                            width: 28px;
                            checked: CustomerHub.list-all-selected;
                            toggled => { CustomerHub.list-toggle-all(self.checked); }
                        }
                        Text { width: 88px; text: "MÃ KH"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "TÊN PHÁP LÝ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 135px; text: "PHƯỜNG/XÃ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 105px; text: "LOẠI"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 130px; text: "ĐẠI DIỆN"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 48px; text: "HĐ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 124px; text: "TRẠNG THÁI"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 64px; text: ""; }
                    }
                }
                for row[index] in root.rows : Rectangle {
                    height: 42px;
                    background: row.selected ? Theme.primary-tint : (rta.has-hover ? Theme.primary-tint : Theme.surface);
                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 8px;
                        CheckBox {
                            width: 28px;
                            checked: row.selected;
                            toggled => { root.toggle-row(index); }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            rta := TouchArea { mouse-cursor: pointer; clicked => { root.open-detail(row.id); } }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { width: 88px; text: row.code; color: Theme.primary; font-size: Theme.font-body; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                Text { horizontal-stretch: 1; text: row.name; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; overflow: elide; }
                                Text { width: 135px; text: row.ward; color: Theme.text-2; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
                                Text { width: 105px; text: row.customer-type; color: Theme.text-2; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
                                Text { width: 130px; text: row.representative; color: Theme.text-2; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
                                Text { width: 48px; text: row.contracts > 0 ? row.contracts : "—"; color: Theme.text; font-size: Theme.font-body; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
                                HorizontalLayout {
                                    width: 124px;
                                    alignment: start;
                                    StatusBadge { y: (parent.height - self.height) / 2; label: row.status-label; variant: row.status-variant; }
                                }
                            }
                        }
                        CfButton {
                            height: 32px;
                            width: 64px;
                            y: (parent.height - self.height) / 2;
                            text: "Sửa";
                            clicked => { CustomerHub.open-edit(row.id); }
                        }
                    }
                }
            }
        }
    }

    // Chân trang: xóa đã chọn, phân trang
    if root.rows.length > 0 || root.has-prev || root.has-next : HorizontalLayout {
        spacing: Theme.gap;
        height: 36px;
        if root.selected-count > 0 : CfButton {
            text: "Xóa đã chọn (" + root.selected-count + ")";
            variant: "danger";
            clicked => { root.delete-selected(); }
        }
        Rectangle { horizontal-stretch: 1; }
        CfButton { text: "‹ Trước"; enabled: root.has-prev; clicked => { root.prev-page(); } }
        Text { text: root.page-text; color: Theme.text; vertical-alignment: center; }
        CfButton { text: "Sau ›"; enabled: root.has-next; clicked => { root.next-page(); } }
    }

    Rectangle { vertical-stretch: 1; }
}
