import { CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card, CfButton } from "../components/common.slint";
import { ContractHub, IdLabel } from "../globals.slint";

// S17 — Gia hạn hợp đồng (Phụ lục gia hạn hoặc Hợp đồng mới).
export component RenewalFormScreen inherits ScrollView {
    in property <string> parent-title;
    in-out property <string> renew-mode: "appendix";
    in-out property <string> contract-number;
    in-out property <string> start-date;
    in-out property <string> months-text;
    in-out property <string> sign-date;
    in property <string> comparison-text;
    in property <[IdLabel]> products;
    in property <[string]> template-names;
    in property <int> template-index: 0;
    in property <string> error-text;

    callback back();
    callback mode-changed(string);
    callback toggle-product(int);
    callback template-changed(int);
    callback save(string, string, string, string, bool);

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        HorizontalLayout {
            height: 36px;
            spacing: Theme.gap;
            CfButton { text: "‹ Quay lại hợp đồng"; clicked => { root.back(); } }
            Text { text: "Gia hạn — " + root.parent-title; font-size: Theme.font-title; font-weight: 700; color: Theme.text; vertical-alignment: center; }
        }

        if root.error-text != "" : Card {
            border-color: Theme.danger-fg;
            background: Theme.danger-bg;
            HorizontalLayout { padding: 10px; Text { text: root.error-text; color: Theme.danger-fg; wrap: word-wrap; } }
        }

        // So sánh giá theo tháng (3 cột giống Python)
        if ContractHub.renew-old-monthly != "" : Card {
            VerticalLayout {
                padding: Theme.pad;
                spacing: 8px;
                Text { text: "SO SÁNH GIÁ THEO THÁNG (VNĐ)"; font-size: Theme.font-small; font-weight: 700; color: Theme.primary; }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 2px;
                        Text { text: "HỢP ĐỒNG CŨ"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                        Text { text: ContractHub.renew-old-monthly; font-size: Theme.font-body; font-weight: 700; color: Theme.text; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 2px;
                        Text { text: "GIA HẠN (GIÁ HIỆN TẠI)"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                        Text { text: ContractHub.renew-new-monthly; font-size: Theme.font-body; font-weight: 700; color: Theme.primary; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 2px;
                        Text { text: "CHÊNH LỆCH"; font-size: Theme.font-xs; font-weight: 700; color: Theme.text-muted; }
                        Text { text: ContractHub.renew-diff-monthly; font-size: Theme.font-body; font-weight: 700; color: Theme.info-fg; }
                    }
                }
            }
        }

        Card {
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.gap;
                Text { text: "CÁCH GIA HẠN"; font-size: Theme.font-small; font-weight: 700; color: Theme.info-fg; }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { width: 160px; text: "Hình thức gia hạn"; color: Theme.text; vertical-alignment: center; }
                    ComboBox {
                        width: 300px;
                        height: 32px;
                        model: ["Phụ lục gia hạn trên hợp đồng này", "Ký hợp đồng mới (liên kết về HĐ này)"];
                        current-index: root.renew-mode == "contract" ? 1 : 0;
                        selected(v) => {
                            root.renew-mode = self.current-index == 1 ? "contract" : "appendix";
                            root.mode-changed(root.renew-mode);
                        }
                    }
                }
                if root.renew-mode == "contract" : HorizontalLayout {
                    spacing: Theme.gap;
                    Text { width: 160px; text: "Số hợp đồng mới *"; color: Theme.text; vertical-alignment: center; }
                    LineEdit { horizontal-stretch: 1; height: 32px; text <=> root.contract-number; }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { width: 160px; text: "Ngày bắt đầu *"; color: Theme.text; vertical-alignment: center; }
                    LineEdit { width: 150px; height: 32px; text <=> root.start-date; placeholder-text: "dd/mm/yyyy"; }
                    Text { width: 80px; text: "Số tháng *"; color: Theme.text; vertical-alignment: center; }
                    LineEdit { width: 80px; height: 32px; text <=> root.months-text; }
                    Text { width: 70px; text: "Ngày ký"; color: Theme.text; vertical-alignment: center; }
                    LineEdit { width: 150px; height: 32px; text <=> root.sign-date; placeholder-text: "dd/mm/yyyy"; }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { width: 160px; text: "Mẫu văn bản"; color: Theme.text; vertical-alignment: center; }
                    ComboBox {
                        horizontal-stretch: 1;
                        height: 32px;
                        model: root.template-names;
                        current-index: root.template-index;
                        selected(v) => { root.template-changed(self.current-index); }
                    }
                }
            }
        }

        Card {
            VerticalLayout {
                padding: Theme.pad;
                spacing: 8px;
                Text { text: "GÓI CHO TỪNG DÒNG"; font-size: Theme.font-small; font-weight: 700; color: Theme.success-fg; }
                Rectangle { height: 1px; background: Theme.border; }
                if ContractHub.renew-lines.length > 0 : VerticalLayout {
                    spacing: 6px;
                    for ln in ContractHub.renew-lines : HorizontalLayout {
                        spacing: Theme.gap;
                        Text { width: 280px; text: ln.old-label; color: Theme.text-muted; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
                        ComboBox {
                            horizontal-stretch: 1;
                            height: 32px;
                            model: ContractHub.renew-candidate-names;
                            current-index: ln.selected-index;
                            selected(v) => { ContractHub.renew-line-changed(ln.idx, self.current-index); }
                        }
                    }
                }
                if ContractHub.renew-lines.length == 0 : VerticalLayout {
                    spacing: 6px;
                    for item[idx] in root.products : CheckBox {
                        text: item.label;
                        checked: item.checked;
                        toggled => { root.toggle-product(idx); }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: Theme.gap;
            CfButton { text: "Hủy"; clicked => { root.back(); } }
            CfButton { text: "Lưu nháp"; clicked => { root.save(root.contract-number, root.start-date, root.months-text, root.sign-date, false); } }
            CfButton { text: "Lưu và sinh file"; variant: "primary"; clicked => { root.save(root.contract-number, root.start-date, root.months-text, root.sign-date, true); } }
        }
    }
}
