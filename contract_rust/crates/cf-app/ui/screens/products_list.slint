import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card, CfButton, EmptyState, StatusBadge, TabPill } from "../components/common.slint";
import { ProductRowData } from "../types.slint";

export component ProductsListScreen inherits VerticalLayout {
    in property <[ProductRowData]> rows;
    in property <string> show: "active";
    in property <string> empty-message;
    callback show-changed(string);
    callback toggle-active(int);
    callback add-product();
    callback edit-product(int);
    callback import-products();
    spacing: 10px;

    HorizontalLayout {
        height: 36px;
        spacing: 8px;
        TabPill { y: (parent.height - self.height) / 2; text: "Đang bán"; active: root.show == "active"; clicked => { root.show-changed("active"); } }
        TabPill { y: (parent.height - self.height) / 2; text: "Đã ngừng bán"; active: root.show == "inactive"; clicked => { root.show-changed("inactive"); } }
        TabPill { y: (parent.height - self.height) / 2; text: "Tất cả"; active: root.show == "all"; clicked => { root.show-changed("all"); } }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.rows.length + " sản phẩm"; color: Theme.text-muted; font-size: Theme.font-small; vertical-alignment: center; }
        CfButton { text: "Import / Export Excel"; variant: "outline-primary"; clicked => { root.import-products(); } }
        CfButton { text: "+ Thêm sản phẩm"; variant: "primary"; clicked => { root.add-product(); } }
    }

    Rectangle {
        height: 34px;
        background: Theme.surface-2;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius-sm;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Text { width: 92px; text: "MÃ"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; vertical-alignment: center; }
            Text { horizontal-stretch: 1; text: "TÊN SẢN PHẨM"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; vertical-alignment: center; }
            Text { width: 95px; text: "NHÓM"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; vertical-alignment: center; }
            Text { width: 95px; text: "KIỂU"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; vertical-alignment: center; }
            Text { width: 95px; text: "LOẠI"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; vertical-alignment: center; }
            Text { width: 65px; text: "ĐVT"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; vertical-alignment: center; }
            Text { width: 105px; text: "ĐƠN GIÁ"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
            Text { width: 52px; text: "VAT"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            Text { width: 72px; text: "THỜI HẠN"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            Text { width: 95px; text: "TRẠNG THÁI"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            Text { width: 58px; text: "HĐ"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            Text { width: 145px; text: ""; }
        }
    }

    if root.rows.length == 0 : EmptyState {
        vertical-stretch: 1;
        message: root.empty-message;
    }
    if root.rows.length > 0 : Card {
        vertical-stretch: 1;
        clip: true;
        ScrollView {
            VerticalLayout {
                spacing: 0px;
                for row in root.rows : VerticalLayout {
                    if row.show-group : Rectangle {
                        height: 30px;
                        background: Theme.primary-tint;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { text: row.group-title; color: Theme.primary; font-size: Theme.font-small; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        height: 42px;
                        background: row.active ? Theme.surface : Theme.surface-2;
                        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text { width: 92px; text: row.code; color: Theme.primary; font-weight: 700; vertical-alignment: center; overflow: elide; }
                            Text { horizontal-stretch: 1; text: row.name; color: Theme.text; vertical-alignment: center; overflow: elide; }
                            Text { width: 95px; text: row.group-title; color: Theme.text-muted; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
                            Text { width: 95px; text: row.kind; color: Theme.text-2; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
                            Text { width: 95px; text: row.product-type; color: Theme.text-2; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
                            Text { width: 65px; text: row.unit-label; color: Theme.text; vertical-alignment: center; overflow: elide; }
                            Text { width: 105px; text: row.price; color: Theme.text; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 52px; text: row.vat; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 72px; text: row.duration; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                            HorizontalLayout {
                                width: 95px;
                                alignment: center;
                                StatusBadge { y: (parent.height - self.height) / 2; label: row.active ? "Đang bán" : "Ngừng bán"; variant: row.active ? "success" : "secondary"; }
                            }
                            Text { width: 58px; text: row.in-service-count; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                            HorizontalLayout {
                                width: 145px;
                                spacing: 4px;
                                alignment: end;
                                CfButton { text: row.active ? "Ngừng" : "Bán lại"; clicked => { root.toggle-active(row.id); } }
                                CfButton { text: "Sửa"; variant: "outline-primary"; clicked => { root.edit-product(row.id); } }
                            }
                        }
                    }
                }
            }
        }
    }
}
