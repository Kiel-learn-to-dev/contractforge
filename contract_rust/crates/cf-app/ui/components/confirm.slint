import { Theme } from "../theme.slint";
import { CfButton } from "common.slint";

// Hộp xác nhận modal: lớp mờ phủ cửa sổ + thẻ ở giữa. Rust bật/tắt bằng `shown`.
// Đây là lớp phủ trong cửa sổ chính (không dùng PopupWindow) để đơn giản hóa việc đặt vị trí.
export component ConfirmDialog inherits Rectangle {
    in property <bool> shown: false;
    in property <string> title;
    in property <string> message;
    callback confirmed();
    callback cancelled();

    visible: shown;
    background: #00000066;

    // Chặn thao tác bên dưới khi hộp đang mở.
    TouchArea { }

    Rectangle {
        width: min(460px, root.width - 40px);
        height: min(root.height - 40px, max(168px, dialog-content.preferred-height));
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-color: Theme.border;
        border-width: 1px;

        dialog-content := VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.gap;
            Text {
                text: root.title;
                font-size: Theme.font-title;
                font-weight: 700;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: root.message;
                font-size: Theme.font-body;
                color: Theme.text;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.gap;
                CfButton { text: "Hủy"; clicked => { root.cancelled(); } }
                CfButton { text: "Đồng ý"; variant: "primary"; clicked => { root.confirmed(); } }
            }
        }
    }
}
