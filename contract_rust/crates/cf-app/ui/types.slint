// Kiểu dữ liệu dùng chung giữa các màn hình. Rust điền sẵn mọi chuỗi đã định dạng.
export struct CustomerRowData {
    id: int,
    code: string,
    name: string,
    ward: string,
    customer-type: string,
    representative: string,
    units: int,
    contracts: int,
    selected: bool,
    status-label: string,
    status-variant: string,
}

