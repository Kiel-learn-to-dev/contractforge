}

export struct TopCustomerRow {
    id: int,
    name: string,
    count: int,
}

export struct RecentActivityRow {
    contract-id: int,
    title: string,
    subtitle: string,
    when-text: string,
}

// S01 — Mở rộng dữ liệu Dashboard (biểu đồ, phân bố trạng thái, hết hạn, top KH, hoạt động gần đây).
export global DashboardHub {
    in-out property <string> submode: "overview"; // "overview" | "expiring"
    in-out property <string> today-label;
    in-out property <[ForecastBarItem]> forecast-bars;
    in-out property <[StatusDistItem]> status-dist;
    in-out property <[ProductPieItem]> pie-items;
    in-out property <[ExpiringSummaryRow]> expiring-30;
    in-out property <[ExpiringSummaryRow]> expiring-31-60;
    in-out property <string> value-total-text;
    in-out property <string> value-in-force-sub;
    in-out property <string> value-paid-text;
    in-out property <string> value-invoiced-text;
    in-out property <string> value-unpaid-text;
    in-out property <string> monthly-title;
    in-out property <string> monthly-new-text;
    in-out property <string> monthly-signed-text;
    in-out property <string> monthly-expired-text;
    in-out property <string> monthly-value-text;
    in-out property <[TopCustomerRow]> top-customers;
    in-out property <[RecentActivityRow]> recent-activities;

    callback refresh();
    callback quick-nav(int);
    callback open-value-status(string);
    callback open-expiring(int);
    callback back-to-overview();
    callback open-contract(int);
    callback open-customer(int);
    callback open-action(int);
    callback open-metric(int);
}

export struct ExpiringRowData {
    contract-id: int,
    customer-id: int,
    contract-number: string,
    customer-name: string,
    end-date: string,
    days-left: int,
    status-label: string,
    total-text: string,
    urgency: string,
}

// S02 — Danh sách hợp đồng sắp hết hạn (theo mốc ngày + xuất CSV).
export global ExpiringHub {
    in-out property <int> days: 30;
    in-out property <[ExpiringRowData]> rows;
    in-out property <string> summary-text;

    callback load-days(int);
    callback export-csv();
    callback open-contract(int);
    callback open-customer(int);
    callback back();
}

export struct SearchResultRow {
    kind: string,
    id: int,
    label: string,
    sub: string,
    status: string,
}

// Tìm kiếm nhanh toàn cục ở thanh trên cùng.
export global SearchHub {
    in-out property <string> query;
    in-out property <bool> open: false;
    in-out property <[SearchResultRow]> results;

    callback search-changed(string);
    callback submit-first();
    callback pick-result(string, int);
    callback close-popup();
    pure callback filter-model(string, [string]) -> [int];
    callback date-from-text(string) -> Date;
    // 42 ô (6 tuần x 7 ngày, bắt đầu từ Thứ 2); 0 = ô trống.
    pure callback month-days(int, int) -> [int];
}
